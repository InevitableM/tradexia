# Server
PORT=4000
NODE_ENV=development

# ADK Service
ADK_BASE_URL=http://localhost:8000
ADK_API_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
